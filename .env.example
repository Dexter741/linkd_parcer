# Copy to .env and adjust. Generate secrets with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(40))'
DJANGO_SECRET_KEY=change-me
# false when the admin is reachable from other machines
DJANGO_DEBUG=false
# Host names / IPs the admin is opened by, comma-separated
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=linkd
POSTGRES_USER=linkd
POSTGRES_PASSWORD=change-me
# Where Django finds PostgreSQL when it runs outside Docker
# (Docker containers always use db:5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Docker: host ports for PostgreSQL (loopback only) and the admin
DB_HOST_PORT=5432
WEB_PORT=8000

# Scraper pacing. Slower is safer; 2-5 s (3.5 s average) is ~1000 requests/hour.
LINKEDIN_MIN_DELAY=2.0
LINKEDIN_MAX_DELAY=5.0
LINKEDIN_MAX_RETRIES=4
LINKEDIN_BACKOFF_BASE=30
# Max results LinkedIn serves per search; measure with `linkedin_probe --find-cap`
LINKEDIN_RESULT_CAP=1000
# Optional proxy for all LinkedIn requests: http://user:pass@host:port
LINKEDIN_PROXY=
# Docker: minutes to pause when LinkedIn throttles before continuing
WAIT_ON_BLOCK=15
